    </div>

    <script>
        function openCalendlyModal() {
            var overlay = document.getElementById('calendly-modal-overlay');
            var iframe = document.getElementById('calendly-modal-iframe');
            if (!iframe.getAttribute('src')) {
                var baseUrl = iframe.getAttribute('data-src');
                iframe.setAttribute('src', baseUrl + "&embed_domain=" + window.location.hostname + "&embed_type=Inline");
            }
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeCalendlyModal() {
            var overlay = document.getElementById('calendly-modal-overlay');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        }
        function handleOverlayClick(e) {
            if (e.target === document.getElementById('calendly-modal-overlay')) {
                closeCalendlyModal();
            }
        }
        // Cerrar con tecla Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeCalendlyModal();
        });
        // Redirigir a /gracias cuando el usuario agenda exitosamente
        window.addEventListener('message', function (e) {
            if (e.data && e.data.event === 'calendly.event_scheduled') {
                window.location.href = '/gracias';
            }
        });
    </script>

