            height: 18px;
            flex-shrink: 0;
        }

        /* ── Overlay / Modal ── */
        #calendly-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: #292525ff;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            align-items: center;
            justify-content: center;
            padding: 1rem;
            animation: fadeOverlay 0.3s ease;
        }

        #calendly-modal-overlay.active {
            display: flex;
        }

        @keyframes fadeOverlay {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        #calendly-modal-box {
            position: relative;
            width: 100%;
            max-width: 900px;
            max-height: 90vh;
            background: linear-gradient(135deg, #0f2e42 0%, #004d49 100%);
            border: 1px solid rgba(0, 186, 178, 0.35);
            border-radius: 24px;
            overflow: hidden;
            box-shadow:
                0 0 0 1px rgba(0, 186, 178, 0.15),
                0 40px 80px rgba(0, 0, 0, 0.7),
                0 0 60px rgba(0, 186, 178, 0.1) inset;
            animation: slideModal 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        @keyframes slideModal {
            from {
                transform: translateY(40px) scale(0.96);
                opacity: 0;
            }

            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        #calendly-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.1rem 1.6rem;
            background: rgba(0, 186, 178, 0.08);
            border-bottom: 1px solid rgba(0, 186, 178, 0.25);
        }

        #calendly-modal-header .modal-title {
            font-family: 'Baloo 2', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: #00eae3;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        #calendly-modal-close {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            font-size: 1.3rem;
            line-height: 1;
            transition: background 0.2s, color 0.2s, transform 0.2s;
        }

        #calendly-modal-close:hover {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            transform: scale(1.1);
        }

        #calendly-modal-iframe {
            width: 100%;
            height: calc(90vh - 58px);
            min-height: 500px;
            border: none;
            display: block;
            background: #0f1117;
        }

        /* Escaneo decorativo sobre el modal */
        #calendly-modal-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #00bab2, #00eae3, #004d49, #00bab2);
            background-size: 200% 100%;
            animation: shimmer 3s linear infinite;
            z-index: 1;
        }

        @keyframes shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }
    </style>

